{
  "jus-hard-rules": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PreToolUse ~/.jus-skills/hooks/scripts/jus-block-force-push.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PreToolUse ~/.jus-skills/hooks/scripts/jus-block-no-verify.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PreToolUse ~/.jus-skills/hooks/scripts/jus-pre-commit-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PreToolUse ~/.jus-skills/hooks/scripts/jus-block-accepted-manifest-edit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PreToolUse ~/.jus-skills/hooks/scripts/jus-blocker-date-nudge.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PreToolUse ~/.jus-skills/hooks/scripts/jus-block-lint-suppression.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PostToolUse ~/.jus-skills/hooks/scripts/jus-track-edits.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PostToolUse ~/.jus-skills/hooks/scripts/jus-post-bash-tracker.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PostToolUse ~/.jus-skills/hooks/scripts/jus-start-comment-nudge.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PostToolUse ~/.jus-skills/hooks/scripts/jus-docs-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh PreInvocation ~/.jus-skills/hooks/scripts/jus-ticket-claim-nudge.sh",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "~/.jus-skills/hooks/antigravity/scripts/jus-antigravity-adapt.sh Stop ~/.jus-skills/hooks/scripts/jus-stop-uncommitted.sh",
        "timeout": 15
      }
    ]
  }
}
