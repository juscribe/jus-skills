{
  "description": "Juscribe SOP enforcement hooks for OpenAI Codex — deterministic backstops to the prompt-level rules in the hard-rules skill. Every command is `jus hook <name>` (#4759): jus resolves the bundle at run time, so no path is baked in here. See hooks/codex/README.md for setup and the trust flow.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook jus-block-force-push",
            "timeout": 10,
            "statusMessage": "jus: force-push guard"
          },
          {
            "type": "command",
            "command": "jus hook jus-block-no-verify",
            "timeout": 10,
            "statusMessage": "jus: --no-verify guard"
          },
          {
            "type": "command",
            "command": "jus hook jus-pre-commit-gate",
            "timeout": 10,
            "statusMessage": "jus: pre-commit lint gate"
          },
          {
            "type": "command",
            "command": "jus hook jus-block-accepted-manifest-edit",
            "timeout": 10,
            "statusMessage": "jus: accepted-manifest guard"
          },
          {
            "type": "command",
            "command": "jus hook jus-blocker-date-nudge",
            "timeout": 10,
            "statusMessage": "jus: blocker-date nudge"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt codex jus-block-lint-suppression",
            "timeout": 10,
            "statusMessage": "jus: lint-suppression guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook jus-post-bash-tracker",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook jus-docs-nudge",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt codex jus-track-edits",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt codex jus-start-comment-nudge",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt codex jus-docs-nudge",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jus hook jus-stop-uncommitted",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jus hook jus-ticket-claim-nudge",
            "timeout": 15,
            "statusMessage": "jus: ticket pickup"
          }
        ]
      }
    ]
  }
}
