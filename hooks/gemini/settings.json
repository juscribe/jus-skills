{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "name": "jus-block-force-push",
            "type": "command",
            "command": "jus hook --adapt gemini jus-block-force-push",
            "timeout": 10000
          },
          {
            "name": "jus-block-no-verify",
            "type": "command",
            "command": "jus hook --adapt gemini jus-block-no-verify",
            "timeout": 10000
          },
          {
            "name": "jus-pre-commit-gate",
            "type": "command",
            "command": "jus hook --adapt gemini jus-pre-commit-gate",
            "timeout": 10000
          },
          {
            "name": "jus-block-accepted-manifest-edit",
            "type": "command",
            "command": "jus hook --adapt gemini jus-block-accepted-manifest-edit",
            "timeout": 10000
          },
          {
            "name": "jus-blocker-date-nudge",
            "type": "command",
            "command": "jus hook --adapt gemini jus-blocker-date-nudge",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "^(replace|write_file)$",
        "hooks": [
          {
            "name": "jus-block-lint-suppression",
            "type": "command",
            "command": "jus hook --adapt gemini jus-block-lint-suppression",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "name": "jus-post-bash-tracker",
            "type": "command",
            "command": "jus hook --adapt gemini jus-post-bash-tracker",
            "timeout": 10000
          },
          {
            "name": "jus-docs-nudge",
            "type": "command",
            "command": "jus hook --adapt gemini jus-docs-nudge",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "^(replace|write_file)$",
        "hooks": [
          {
            "name": "jus-track-edits",
            "type": "command",
            "command": "jus hook --adapt gemini jus-track-edits",
            "timeout": 10000
          },
          {
            "name": "jus-start-comment-nudge",
            "type": "command",
            "command": "jus hook --adapt gemini jus-start-comment-nudge",
            "timeout": 10000
          },
          {
            "name": "jus-docs-nudge",
            "type": "command",
            "command": "jus hook --adapt gemini jus-docs-nudge",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "jus-ticket-claim-nudge",
            "type": "command",
            "command": "jus hook --adapt gemini jus-ticket-claim-nudge",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "jus-stop-uncommitted",
            "type": "command",
            "command": "jus hook --adapt gemini jus-stop-uncommitted",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
