{
  "version": 1,
  "disableAllHooks": false,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-force-push.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-no-verify.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-pre-commit-gate.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-accepted-manifest-edit.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-blocker-date-nudge.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-lint-suppression.sh",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-track-edits.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-post-bash-tracker.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-start-comment-nudge.sh",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-docs-nudge.sh",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-stop-uncommitted.sh",
        "timeoutSec": 15
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "~/.jus-skills/hooks/copilot/scripts/jus-copilot-adapt.sh ~/.jus-skills/hooks/scripts/jus-ticket-claim-nudge.sh",
        "timeoutSec": 15
      }
    ]
  }
}
