{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-force-push.sh"
      },
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-no-verify.sh"
      },
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-pre-commit-gate.sh"
      },
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-accepted-manifest-edit.sh"
      },
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-blocker-date-nudge.sh"
      }
    ],
    "preToolUse": [
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-lint-suppression.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-post-bash-tracker.sh"
      },
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-docs-nudge.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-track-edits.sh"
      },
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-start-comment-nudge.sh"
      },
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-docs-nudge.sh"
      }
    ],
    "stop": [
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-stop-uncommitted.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "~/.jus-skills/hooks/cursor/scripts/jus-cursor-adapt.sh ~/.jus-skills/hooks/scripts/jus-ticket-claim-nudge.sh"
      }
    ]
  }
}
