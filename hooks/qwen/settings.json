{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-block-force-push",
            "name": "jus-block-force-push",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-block-no-verify",
            "name": "jus-block-no-verify",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-pre-commit-gate",
            "name": "jus-pre-commit-gate",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-block-accepted-manifest-edit",
            "name": "jus-block-accepted-manifest-edit",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-blocker-date-nudge",
            "name": "jus-blocker-date-nudge",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-block-lint-suppression",
            "name": "jus-block-lint-suppression",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-post-bash-tracker",
            "name": "jus-post-bash-tracker",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-docs-nudge",
            "name": "jus-docs-nudge-bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-track-edits",
            "name": "jus-track-edits",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-start-comment-nudge",
            "name": "jus-start-comment-nudge",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-docs-nudge",
            "name": "jus-docs-nudge-edit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-stop-uncommitted",
            "name": "jus-stop-uncommitted",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jus hook --adapt qwen jus-ticket-claim-nudge",
            "name": "jus-ticket-claim-nudge",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
