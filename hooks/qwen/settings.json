{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-force-push.sh",
            "name": "jus-block-force-push",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-no-verify.sh",
            "name": "jus-block-no-verify",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-pre-commit-gate.sh",
            "name": "jus-pre-commit-gate",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-accepted-manifest-edit.sh",
            "name": "jus-block-accepted-manifest-edit",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-blocker-date-nudge.sh",
            "name": "jus-blocker-date-nudge",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-block-lint-suppression.sh",
            "name": "jus-block-lint-suppression",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-post-bash-tracker.sh",
            "name": "jus-post-bash-tracker",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-docs-nudge.sh",
            "name": "jus-docs-nudge-bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(edit|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-track-edits.sh",
            "name": "jus-track-edits",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-start-comment-nudge.sh",
            "name": "jus-start-comment-nudge",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-docs-nudge.sh",
            "name": "jus-docs-nudge-edit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-stop-uncommitted.sh",
            "name": "jus-stop-uncommitted",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.jus-skills/hooks/qwen/scripts/jus-qwen-adapt.sh ~/.jus-skills/hooks/scripts/jus-ticket-claim-nudge.sh",
            "name": "jus-ticket-claim-nudge",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
